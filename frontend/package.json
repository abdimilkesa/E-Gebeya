{
  "name": "@marketplace/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "React single-page app: map discovery, storefronts, cart, merchant and admin dashboards",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
